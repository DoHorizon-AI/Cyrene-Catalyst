{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cyrene.dev/catalyst/product/v1/data-tools.schema.json",
  "title": "Catalyst data tools Product DTOs v1",
  "$defs": {
    "ArtifactRef": {
      "$ref": "./generated/platform/artifact-ref.schema.json"
    },
    "Sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "SourceRevision": {
      "type": "object",
      "required": [
        "id", "datasetId", "sourceId", "revision", "filename", "mediaType",
        "byteLength", "digest", "artifact", "createdAt", "resourceVersion"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "datasetId": {"type": "string", "format": "uuid"},
        "sourceId": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "filename": {"type": "string", "minLength": 1, "maxLength": 300},
        "mediaType": {"type": "string", "minLength": 1, "maxLength": 200},
        "byteLength": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/Sha256Digest"},
        "artifact": {"$ref": "#/$defs/ArtifactRef"},
        "createdAt": {"type": "string", "format": "date-time"},
        "resourceVersion": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "ContentPolicy": {
      "type": "object",
      "required": [
        "allowKnowledge", "allowTraining", "allowedPrincipalRefs", "allowedUsePurposes"
      ],
      "properties": {
        "allowKnowledge": {"type": "boolean"},
        "allowTraining": {"type": "boolean"},
        "allowedPrincipalRefs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1, "maxLength": 500},
          "uniqueItems": true,
          "description": "An empty array denies access."
        },
        "allowedUsePurposes": {
          "type": "array",
          "items": {"type": "string", "enum": ["knowledge_retrieval", "model_training"]},
          "uniqueItems": true,
          "description": "An empty array denies use; model_training is consumed by generation, knowledge_retrieval by the knowledge package."
        }
      },
      "additionalProperties": false
    },
    "LocatorProvenance": {
      "type": "object",
      "description": "Parser-owned source-location evidence; preserve fields without implying they are source character offsets.",
      "additionalProperties": true
    },
    "ContentLocator": {
      "type": "object",
      "required": ["sourcePages", "sectionPath", "itemRef", "treeLevel", "provenance"],
      "properties": {
        "sourcePages": {
          "type": "array",
          "items": {"type": "integer", "minimum": 1},
          "uniqueItems": true,
          "description": "One-based original-source page numbers; empty when unavailable."
        },
        "sectionPath": {"type": "array", "items": {"type": "string"}},
        "itemRef": {"type": "string", "minLength": 1},
        "treeLevel": {"type": "integer", "minimum": 0},
        "tableIndex": {"type": "integer", "minimum": 0},
        "provenance": {
          "type": "array",
          "items": {"$ref": "#/$defs/LocatorProvenance"}
        }
      },
      "additionalProperties": false
    },
    "BlockOrigin": {
      "type": "string",
      "enum": ["EXTRACTED", "NORMALIZED", "HUMAN_EDITED", "GENERATED"]
    },
    "GenerationReceipt": {
      "type": "object",
      "required": [
        "recipeId", "recipeVersion", "recipeDigest", "bindingId", "model",
        "budget", "usage", "generatedAt", "sourceBlockIds"
      ],
      "properties": {
        "recipeId": {"type": "string", "minLength": 1, "maxLength": 200},
        "recipeVersion": {"type": "string", "minLength": 1, "maxLength": 100},
        "recipeDigest": {"$ref": "#/$defs/Sha256Digest"},
        "bindingId": {"type": "string", "minLength": 1, "maxLength": 500},
        "model": {"type": "string", "minLength": 1, "maxLength": 500},
        "budget": {"type": "object", "additionalProperties": true},
        "usage": {"type": "object", "additionalProperties": true},
        "generatedAt": {"type": "string", "format": "date-time"},
        "sourceBlockIds": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 300}
        }
      },
      "additionalProperties": false
    },
    "ContentBlock": {
      "type": "object",
      "required": ["id", "sourceRevisionId", "ordinal", "kind", "text", "locator", "origin", "policy"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "sourceRevisionId": {"type": "string", "format": "uuid"},
        "ordinal": {"type": "integer", "minimum": 0},
        "sourceFamilyId": {
          "type": "string", "minLength": 1, "maxLength": 300,
          "description": "Primary stable SFT split key; takes precedence over groupId and conversationId."
        },
        "groupId": {
          "type": "string", "minLength": 1, "maxLength": 300,
          "description": "Stable grouping fallback only when sourceFamilyId is absent; do not derive from content digest."
        },
        "conversationId": {"type": "string", "minLength": 1, "maxLength": 300},
        "sampleId": {"type": "string", "minLength": 1, "maxLength": 500},
        "kind": {"type": "string", "minLength": 1, "maxLength": 80},
        "text": {
          "type": "string",
          "description": "For SFT-eligible records, canonical JSON text: instruction/input/output or a human/gpt conversation."
        },
        "locator": {"$ref": "#/$defs/ContentLocator"},
        "origin": {"$ref": "#/$defs/BlockOrigin"},
        "policy": {"$ref": "#/$defs/ContentPolicy"},
        "generationReceipt": {"$ref": "#/$defs/GenerationReceipt"}
      },
      "additionalProperties": false
    },
    "TrainingCurationCounts": {
      "type": "object",
      "required": ["total", "recognized", "formatErrors", "duplicateCandidates", "pendingReview", "excluded", "eligible"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "recognized": {"type": "integer", "minimum": 0},
        "formatErrors": {"type": "integer", "minimum": 0},
        "duplicateCandidates": {"type": "integer", "minimum": 0},
        "pendingReview": {"type": "integer", "minimum": 0},
        "excluded": {"type": "integer", "minimum": 0},
        "eligible": {"type": "integer", "minimum": 0}
      },
      "allOf": [
        {
          "description": "Disposition counters reconcile to the total; other counters are diagnostics and may overlap.",
          "properties": {"total": {"type": "integer"}},
          "x-cyrene-count-invariant": "total = pendingReview + excluded + eligible"
        }
      ],
      "additionalProperties": false
    },
    "TrainingDataSnapshot": {
      "type": "object",
      "required": ["schemaVersion", "artifact", "recordCount", "counts"],
      "properties": {
        "schemaVersion": {"const": "cyrene.training-record.v1"},
        "artifact": {"$ref": "#/$defs/ArtifactRef"},
        "recordCount": {"type": "integer", "minimum": 0},
        "counts": {"$ref": "#/$defs/TrainingCurationCounts"}
      },
      "additionalProperties": false
    },
    "TrainingRecordIssue": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 200},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "severity": {"type": "string", "enum": ["warning", "error"]}
      },
      "additionalProperties": false
    },
    "TrainingMessage": {
      "type": "object",
      "required": ["role", "content"],
      "properties": {
        "role": {"type": "string", "minLength": 1, "maxLength": 200},
        "content": {}
      },
      "additionalProperties": true
    },
    "TrainingRecordEnvelope": {
      "type": "object",
      "required": ["schemaVersion", "id", "sampleId", "sourceRevisionId", "sourceFamilyId", "ordinal", "locator", "rawRecord", "rawLine", "detectedFormat", "normalized", "disposition", "issues", "contentDigest", "recipeDigest", "processingHistory", "policy"],
      "properties": {
        "schemaVersion": {"const": "cyrene.training-record.v1"},
        "id": {"type": "string", "minLength": 1, "maxLength": 300},
        "sampleId": {"type": "string", "minLength": 1, "maxLength": 500},
        "sourceRevisionId": {"type": "string", "format": "uuid"},
        "sourceFamilyId": {"type": "string", "minLength": 1, "maxLength": 300},
        "conversationId": {"type": "string", "minLength": 1, "maxLength": 300},
        "ordinal": {"type": "integer", "minimum": 0},
        "locator": {"type": "object", "minProperties": 1, "additionalProperties": true},
        "rawRecord": {},
        "rawLine": {"type": ["string", "null"]},
        "detectedFormat": {"type": "string", "enum": ["alpaca", "promptCompletion", "messages", "sharegpt", "chatml", "unknown"]},
        "normalized": {"oneOf": [{"type": "null"}, {"type": "object", "properties": {"messages": {"type": "array", "items": {"$ref": "#/$defs/TrainingMessage"}}}, "required": ["messages"], "additionalProperties": false}]},
        "disposition": {"type": "string", "enum": ["eligible", "review", "excluded"]},
        "issues": {"type": "array", "items": {"$ref": "#/$defs/TrainingRecordIssue"}},
        "contentDigest": {"$ref": "#/$defs/Sha256Digest"},
        "recipeDigest": {"$ref": "#/$defs/Sha256Digest"},
        "processingHistory": {"type": "array", "items": {"type": "object", "required": ["operation", "recipeDigest"], "properties": {"operation": {"type": "string", "minLength": 1}, "recipeDigest": {"$ref": "#/$defs/Sha256Digest"}, "beforeDigest": {"$ref": "#/$defs/Sha256Digest"}, "afterDigest": {"$ref": "#/$defs/Sha256Digest"}, "actor": {"type": "string"}, "at": {"type": "string", "format": "date-time"}}, "additionalProperties": true}},
        "policy": {"type": "object", "properties": {"allowKnowledge": {"type": "boolean"}, "allowTraining": {"type": "boolean"}, "allowedPrincipalRefs": {"type": "array", "items": {"type": "string"}}, "allowedUsePurposes": {"type": "array", "items": {"type": "string"}}}, "additionalProperties": true}
      },
      "additionalProperties": false
    },
    "TrainingRecordsPage": {
      "type": "object",
      "required": ["revisionId", "offset", "limit", "total", "records"],
      "properties": {
        "revisionId": {"type": "string", "format": "uuid"},
        "offset": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200},
        "total": {"type": "integer", "minimum": 0},
        "records": {"type": "array", "items": {"$ref": "#/$defs/TrainingRecordEnvelope"}}
      },
      "additionalProperties": false
    },
    "ContentRevision": {
      "type": "object",
      "required": [
        "id", "datasetId", "revision", "sourceRevisionIds", "state", "blocks",
        "createdAt", "resourceVersion"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "datasetId": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "parentRevisionId": {"type": "string", "format": "uuid"},
        "sourceRevisionIds": {
          "type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true
        },
        "state": {"type": "string", "enum": ["DRAFT", "APPROVED", "REJECTED"]},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/ContentBlock"}},
        "trainingDataSnapshot": {"$ref": "#/$defs/TrainingDataSnapshot"},
        "createdAt": {"type": "string", "format": "date-time"},
        "reviewedAt": {"type": "string", "format": "date-time"},
        "reviewNote": {"type": "string", "maxLength": 2000},
        "resourceVersion": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "ContentBlockPage": {
      "type": "object",
      "required": ["revisionId", "offset", "limit", "total", "blocks"],
      "properties": {
        "revisionId": {"type": "string", "format": "uuid"},
        "offset": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200},
        "total": {"type": "integer", "minimum": 0},
        "blocks": {"type": "array", "items": {"$ref": "#/$defs/ContentBlock"}}
      },
      "additionalProperties": false
    },
    "EditBlockRequest": {
      "type": "object",
      "required": ["expectedRevisionId"],
      "properties": {
        "expectedRevisionId": {"type": "string", "format": "uuid"},
        "text": {"type": "string"},
        "policy": {"$ref": "#/$defs/ContentPolicy"}
      },
      "anyOf": [{"required": ["text"]}, {"required": ["policy"]}],
      "additionalProperties": false
    },
    "ReviewContentRequest": {
      "type": "object",
      "required": ["decision"],
      "properties": {
        "decision": {"type": "string", "enum": ["APPROVE", "REJECT"]},
        "note": {"type": "string", "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "EditTrainingRecordRequest": {
      "type": "object",
      "required": ["recordId", "action"],
      "properties": {
        "recordId": {"type": "string", "minLength": 1, "maxLength": 300},
        "action": {"type": "string", "enum": ["approve", "exclude", "remap"]},
        "note": {"type": "string", "maxLength": 2000},
        "format": {"type": "string", "enum": ["auto", "alpaca", "promptCompletion", "messages", "sharegpt", "chatml"]},
        "fieldMapping": {"type": "object", "maxProperties": 100, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 500}},
        "roleMapping": {"type": "object", "maxProperties": 100, "additionalProperties": {"type": "string", "enum": ["system", "user", "assistant"]}},
        "rawRecord": {"type": "object"}
      },
      "allOf": [
        {"if": {"properties": {"action": {"const": "remap"}}, "required": ["action"]}, "then": {"anyOf": [{"required": ["format"]}, {"required": ["fieldMapping"]}, {"required": ["roleMapping"]}, {"required": ["rawRecord"]}]}}
      ],
      "additionalProperties": false
    },
    "EditTrainingRecordsRequest": {
      "type": "object",
      "required": ["resourceVersion", "edits"],
      "properties": {
        "resourceVersion": {"type": "integer", "minimum": 1},
        "edits": {"type": "array", "minItems": 1, "maxItems": 200, "items": {"$ref": "#/$defs/EditTrainingRecordRequest"}},
        "note": {"type": "string", "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "RunOperation": {
      "type": "string",
      "enum": ["parse", "curateTrainingData", "buildKnowledge", "prepareSft", "generateQa"]
    },
    "RunState": {
      "type": "string",
      "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "FAILED", "CANCELLED", "INTERRUPTED"]
    },
    "CreateProcessingRunRequest": {
      "type": "object",
      "required": ["operation"],
      "properties": {
        "operation": {"$ref": "#/$defs/RunOperation"},
        "sourceRevisionIds": {
          "type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true
        },
        "contentRevisionId": {"type": "string", "format": "uuid"},
        "config": {
          "type": "object",
          "properties": {
            "sftMode": {"type": "string", "enum": ["instruction", "conversation"]},
            "outputFormat": {"type": "string", "enum": ["sft", "messages", "promptCompletion"]},
            "split": {
              "type": "object",
              "required": ["train", "validation", "test"],
              "properties": {
                "train": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
                "validation": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
                "test": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
                "seed": {"type": "integer", "minimum": 0}
              },
              "additionalProperties": false
            },
            "generation": {
              "type": "object",
              "required": ["maxExamples", "maxCalls"],
              "properties": {
                "maxExamples": {"type": "integer", "minimum": 1},
                "maxCalls": {"type": "integer", "minimum": 1},
                "maxInputTokens": {"type": "integer", "minimum": 1},
                "maxOutputTokens": {"type": "integer", "minimum": 1}
              },
              "additionalProperties": false
            },
            "sourcePolicies": {
              "type": "object",
              "maxProperties": 20,
              "propertyNames": {"format": "uuid"},
              "additionalProperties": {"$ref": "#/$defs/ContentPolicy"},
              "description": "Explicit per-source use grants. Missing entries remain denied for training; explicit prohibition cannot be overridden."
            },
            "curation": {
              "type": "object",
              "required": ["id", "version", "format"],
              "properties": {
                "id": {"type": "string", "minLength": 1, "maxLength": 200},
                "version": {"type": "string", "minLength": 1, "maxLength": 100},
                "format": {"type": "string", "enum": ["auto", "alpaca", "promptCompletion", "messages", "sharegpt", "chatml"]},
                "fieldMapping": {"type": "object", "maxProperties": 100, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 500}},
                "roleMapping": {"type": "object", "maxProperties": 100, "additionalProperties": {"type": "string", "enum": ["system", "user", "assistant"]}},
                "maxCharacters": {"type": "integer", "minimum": 1, "maximum": 10000000, "default": 100000},
                "minCharacters": {"type": "integer", "minimum": 0, "maximum": 10000000, "default": 2},
                "unicodeNormalization": {"type": "string", "enum": ["NFC", "NFD", "NFKC", "NFKD", "none"], "default": "NFC"}
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {
          "if": {"properties": {"operation": {"const": "parse"}}, "required": ["operation"]},
          "then": {"required": ["sourceRevisionIds"], "properties": {"sourceRevisionIds": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"operation": {"const": "curateTrainingData"}}, "required": ["operation"]},
          "then": {
            "required": ["sourceRevisionIds", "config"],
            "properties": {
              "sourceRevisionIds": {"minItems": 1},
              "config": {"required": ["curation"]}
            }
          }
        },
        {
          "if": {"properties": {"operation": {"enum": ["buildKnowledge", "prepareSft", "generateQa"]}}, "required": ["operation"]},
          "then": {"required": ["contentRevisionId"]}
        },
        {
          "if": {"properties": {"operation": {"const": "generateQa"}}, "required": ["operation"]},
          "then": {"required": ["config"], "properties": {"config": {"required": ["generation"]}}}
        }
      ],
      "additionalProperties": false
    },
    "RunFailure": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"},
        "message": {"type": "string"},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "RunWarning": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {"code": {"type": "string"}, "message": {"type": "string"}},
      "additionalProperties": false
    },
    "BatchUploadError": {
      "type": "object",
      "required": ["code", "message", "retryable"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 120},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "retryable": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "BatchSourceUploadItem": {
      "type": "object",
      "required": ["filename", "source", "error"],
      "properties": {
        "filename": {"type": "string", "minLength": 1, "maxLength": 512},
        "source": {
          "anyOf": [
            {"$ref": "#/$defs/SourceRevision"},
            {"type": "null"}
          ]
        },
        "error": {
          "anyOf": [
            {"$ref": "#/$defs/BatchUploadError"},
            {"type": "null"}
          ]
        }
      },
      "oneOf": [
        {"properties": {"source": {"$ref": "#/$defs/SourceRevision"}, "error": {"type": "null"}}},
        {"properties": {"source": {"type": "null"}, "error": {"$ref": "#/$defs/BatchUploadError"}}}
      ],
      "additionalProperties": false
    },
    "BatchSourceUploadResponse": {
      "type": "object",
      "required": ["items"],
      "properties": {
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {"$ref": "#/$defs/BatchSourceUploadItem"}
        }
      },
      "additionalProperties": false
    },
    "ParserLocator": {
      "type": "object",
      "required": ["source_pages", "section_path", "item_ref", "tree_level", "provenance"],
      "properties": {
        "source_pages": {"type": "array", "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "section_path": {"type": "array", "items": {"type": "string"}},
        "item_ref": {"type": "string", "minLength": 1},
        "tree_level": {"type": "integer", "minimum": 0},
        "table_index": {"type": "integer", "minimum": 0},
        "provenance": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
      },
      "additionalProperties": false
    },
    "ParserDiagnostic": {
      "type": "object",
      "required": ["code", "message", "kind", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "kind": {"type": "string", "enum": ["parser", "ocr"]},
        "severity": {"const": "warning"},
        "locator": {"$ref": "#/$defs/ParserLocator"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "UnsupportedContent": {
      "type": "object",
      "description": "Parser-owned structured details for content not converted into blocks.",
      "additionalProperties": true
    },
    "SourceParseReport": {
      "type": "object",
      "required": [
        "id", "datasetId", "sourceRevisionId", "processingRunId", "status", "blockCount",
        "warnings", "diagnostics", "unsupportedContent", "outputArtifacts", "createdAt",
        "updatedAt", "resourceVersion"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "datasetId": {"type": "string", "format": "uuid"},
        "sourceRevisionId": {"type": "string", "format": "uuid"},
        "processingRunId": {"type": "string", "format": "uuid"},
        "status": {"type": "string", "enum": ["QUEUED", "RUNNING", "SUCCEEDED", "WARNING", "FAILED", "INTERRUPTED", "CANCELLED"]},
        "contentRevisionId": {"type": "string", "format": "uuid"},
        "blockCount": {"type": "integer", "minimum": 0},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/RunWarning"}},
        "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/ParserDiagnostic"}},
        "unsupportedContent": {"type": "array", "items": {"$ref": "#/$defs/UnsupportedContent"}},
        "reviewItemCount": {"type": "integer", "minimum": 0},
        "diagnosticCounts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "failure": {"$ref": "#/$defs/RunFailure"},
        "outputArtifacts": {
          "type": "array",
          "items": {"$ref": "#/$defs/ArtifactRef"},
          "description": "SUCCEEDED and WARNING reports contain a source-parse-blocks ArtifactRef."
        },
        "startedAt": {"type": "string", "format": "date-time"},
        "finishedAt": {"type": "string", "format": "date-time"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "resourceVersion": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"enum": ["SUCCEEDED", "WARNING"]}}, "required": ["status"]},
          "then": {
            "properties": {
              "outputArtifacts": {
                "minItems": 1,
                "contains": {
                  "type": "object",
                  "required": ["kind"],
                  "properties": {"kind": {"const": "source-parse-blocks"}}
                }
              }
            }
          }
        },
        {
          "if": {"required": ["contentRevisionId"]},
          "then": {"properties": {"status": {"enum": ["SUCCEEDED", "WARNING"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "FAILED"}}, "required": ["status"]},
          "then": {"required": ["failure"]}
        }
      ],
      "additionalProperties": false
    },
    "ReviewItem": {
      "type": "object",
      "required": [
        "id", "datasetId", "sourceParseReportId", "sourceRevisionId", "processingRunId",
        "kind", "code", "message", "severity", "state", "createdAt", "resourceVersion"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "datasetId": {"type": "string", "format": "uuid"},
        "sourceParseReportId": {"type": "string", "format": "uuid"},
        "sourceRevisionId": {"type": "string", "format": "uuid"},
        "processingRunId": {"type": "string", "format": "uuid"},
        "contentRevisionId": {"type": "string", "format": "uuid"},
        "recordId": {"type": "string", "minLength": 1, "maxLength": 500},
        "kind": {"type": "string", "enum": ["PARSER_WARNING", "OCR_WARNING", "PARSE_FAILURE", "UNSUPPORTED_SOURCE", "TRAINING_STRUCTURE", "TRAINING_DUPLICATE", "TRAINING_QUALITY", "TRAINING_UNSUPPORTED", "TRAINING_LEAKAGE"]},
        "code": {"type": "string", "minLength": 1, "maxLength": 200},
        "message": {"type": "string"},
        "severity": {"type": "string", "minLength": 1, "maxLength": 40},
        "locator": {"$ref": "#/$defs/ContentLocator"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "state": {"type": "string", "enum": ["OPEN", "ACKNOWLEDGED", "REJECTED"]},
        "note": {"type": "string", "maxLength": 2000},
        "createdAt": {"type": "string", "format": "date-time"},
        "resolvedAt": {"type": "string", "format": "date-time"},
        "resourceVersion": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "OPEN"}}, "required": ["state"]}, "then": {"not": {"required": ["resolvedAt"]}}},
        {"if": {"properties": {"state": {"enum": ["ACKNOWLEDGED", "REJECTED"]}}, "required": ["state"]}, "then": {"required": ["resolvedAt"]}}
      ],
      "additionalProperties": false
    },
    "GeneratedDraftSummary": {
      "type": "object",
      "required": ["id", "datasetId", "revision", "state", "blockCount", "sourceRevisionIds", "createdAt"],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "datasetId": {"type": "string", "format": "uuid"},
        "revision": {"type": "integer", "minimum": 1},
        "state": {"const": "DRAFT"},
        "blockCount": {"type": "integer", "minimum": 0},
        "sourceRevisionIds": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
        "createdAt": {"type": "string", "format": "date-time"},
        "processingRunId": {"type": "string", "format": "uuid"}
      },
      "additionalProperties": false
    },
    "ReviewQueueResponse": {
      "type": "object",
      "required": ["items", "generatedDrafts"],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/ReviewItem"}},
        "generatedDrafts": {"type": "array", "items": {"$ref": "#/$defs/GeneratedDraftSummary"}},
        "offset": {"type": "integer", "minimum": 0},
        "limit": {"type": "integer", "minimum": 1, "maximum": 200},
        "total": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "ResolveReviewItemRequest": {
      "type": "object",
      "required": ["action"],
      "properties": {
        "action": {"type": "string", "enum": ["ACKNOWLEDGE", "REJECT"]},
        "note": {"type": "string", "maxLength": 2000}
      },
      "additionalProperties": false
    },
    "ProcessingRun": {
      "type": "object",
      "required": [
        "id", "datasetId", "operation", "state", "sourceRevisionIds", "recipe",
        "recipeDigest", "outputArtifacts", "warnings", "createdAt", "updatedAt", "resourceVersion", "stale"
      ],
      "properties": {
        "id": {"type": "string", "format": "uuid"},
        "datasetId": {"type": "string", "format": "uuid"},
        "operation": {"$ref": "#/$defs/RunOperation"},
        "state": {"$ref": "#/$defs/RunState"},
        "sourceRevisionIds": {"type": "array", "items": {"type": "string", "format": "uuid"}},
        "contentRevisionId": {"type": "string", "format": "uuid"},
        "recipe": {"type": "object"},
        "recipeDigest": {"$ref": "#/$defs/Sha256Digest"},
        "progress": {
          "type": "object", "required": ["completed"],
          "properties": {"completed": {"type": "integer", "minimum": 0}, "total": {"type": "integer", "minimum": 0}},
          "additionalProperties": false
        },
        "outputArtifacts": {"type": "array", "items": {"$ref": "#/$defs/ArtifactRef"}},
        "warnings": {"type": "array", "items": {"$ref": "#/$defs/RunWarning"}},
        "failure": {"$ref": "#/$defs/RunFailure"},
        "retryOfRunId": {"type": "string", "format": "uuid"},
        "createdAt": {"type": "string", "format": "date-time"},
        "updatedAt": {"type": "string", "format": "date-time"},
        "resourceVersion": {"type": "integer", "minimum": 1},
        "stale": {"type": "boolean"}
      },
      "allOf": [
        {"if": {"properties": {"state": {"const": "FAILED"}}, "required": ["state"]}, "then": {"required": ["failure"]}}
      ],
      "additionalProperties": false
    },
    "PublishDataToolsVersionRequest": {
      "type": "object",
      "required": ["contentRevisionId", "sftRunId"],
      "properties": {
        "contentRevisionId": {"type": "string", "format": "uuid"},
        "knowledgeRunId": {"type": "string", "format": "uuid"},
        "sftRunId": {"type": "string", "format": "uuid"}
      },
      "additionalProperties": false
    },
    "DatasetVersionDataTools": {
      "type": "object",
      "required": [
        "contentRevisionId", "sourceRevisionIds", "sftProfile", "sftArtifact", "stale"
      ],
      "properties": {
        "contentRevisionId": {"type": "string", "format": "uuid"},
        "sourceRevisionIds": {"type": "array", "items": {"type": "string", "format": "uuid"}, "uniqueItems": true},
        "knowledgeProfile": {"const": "CYRENE_KNOWLEDGE_BUNDLE_V1"},
        "knowledgeArtifact": {"$ref": "#/$defs/ArtifactRef"},
        "sftProfile": {"const": "CYRENE_SFT_BUNDLE_V1"},
        "sftArtifact": {"$ref": "#/$defs/ArtifactRef"},
        "stale": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  }
}
